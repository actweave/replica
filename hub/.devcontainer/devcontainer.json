{
  "name": "Replica Hub",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces/hub",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "pnpmVersion": "none"
    }
  },
  "forwardPorts": [19500, 3036, 6006],
  "mounts": [
    "source=replica-hub-bundle,target=/usr/local/bundle,type=volume",
    "source=replica-hub-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "onCreateCommand": "sudo chown -R vscode:vscode /usr/local/bundle node_modules",
  "portsAttributes": {
    "19500": { "label": "Replica Hub" },
    "3036": { "label": "Vite HMR" },
    "6006": { "label": "Storybook" }
  },
  "postCreateCommand": "bin/setup --skip-server",
  "runArgs": [
    "--publish",
    "127.0.0.1:19500:19500",
    "--publish",
    "127.0.0.1:3036:3036",
    "--publish",
    "127.0.0.1:6006:6006"
  ],
  "remoteEnv": {
    "REPLICA_BOOTSTRAP_SECRET": "${localEnv:REPLICA_BOOTSTRAP_SECRET}",
    "REPLICA_AUTH_MODE": "${localEnv:REPLICA_AUTH_MODE}",
    "REPLICA_AUTH_EMAIL_ENABLED": "${localEnv:REPLICA_AUTH_EMAIL_ENABLED}",
    "REPLICA_AUTH_GITHUB_ENABLED": "${localEnv:REPLICA_AUTH_GITHUB_ENABLED}",
    "REPLICA_AUTH_ALLOWLIST_EMAILS": "${localEnv:REPLICA_AUTH_ALLOWLIST_EMAILS}",
    "REPLICA_AUTH_BOOTSTRAP_ADMIN_EMAILS": "${localEnv:REPLICA_AUTH_BOOTSTRAP_ADMIN_EMAILS}",
    "RESEND_API_KEY": "${localEnv:RESEND_API_KEY}",
    "RESEND_FROM_EMAIL": "${localEnv:RESEND_FROM_EMAIL}",
    "REPLICA_OIDC_PROVIDERS_JSON": "${localEnv:REPLICA_OIDC_PROVIDERS_JSON}"
  },
  "remoteUser": "vscode"
}
