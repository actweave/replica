json.partial! partial: "shared/access_management"
json.kind "allowlist"
json.pageTitle t("access_management.allowlist")
json.heading t("access_management.allowlist")
json.description t("access_management.admission")
json.submitPath auth_allowlist_entries_path
json.rows do
  json.array! @entries do |entry|
    json.id entry.id
    json.label entry.email
    json.displayName entry.display_name
    json.hubAdmin entry.hub_admin?
    json.path auth_allowlist_entry_path(entry)
  end
end
json.repositories do
  json.array! @managed_repositories do |repository|
    json.label repository.name_with_owner
    json.path repository_memberships_path(repository.route_id)
  end
end
