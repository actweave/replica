local_mode = LocalDevelopment.enabled?
email_enabled = EmailLoginChallenge.enabled?
providers = OidcProvider.enabled.values

json.pageTitle t("application.name")
json.localMode local_mode
json.badge t(local_mode ? "home.index.local_badge" : "home.index.badge")
json.badgeAlternate t(local_mode ? "home.index.local_badge_alternate" : "home.index.badge_alternate")
json.heading t(local_mode ? "home.index.local_heading" : "home.index.heading")
json.description t(local_mode ? "home.index.local_description" : "home.index.description")
json.footerNote t("home.index.footer_note", year: Date.current.year)
json.alert flash[:alert]
json.notice flash[:notice]
json.signInLabel t(local_mode ? "home.index.local_sign_in" : "home.index.sign_in")
json.pauseAnimationLabel t("home.index.pause_animation")
json.resumeAnimationLabel t("home.index.resume_animation")
if local_mode && !LocalDevelopment.unified_auth?
  json.signInPath local_authentication_path
elsif GithubAppConfiguration.sign_in_enabled? && ((!email_enabled && providers.empty?) || GithubAppConfiguration.configured?)
  json.signInPath github_authentication_path
else
  json.signInPath nil
end

json.oidcProviders do
  json.array! providers do |provider|
    json.label t("oidc_login.sign_in", provider: provider.display_name)
    json.path oidc_authentication_path(provider.slug)
  end
end

if email_enabled
  json.emailLogin do
    json.email flash[:email_login]
    json.challengePath email_login_challenges_path
    json.verifyPath verify_email_login_path
    json.restartPath root_path
    json.emailLabel t("email_login.email_label")
    json.codeLabel t("email_login.code_label")
    json.sendLabel t("email_login.send_label")
    json.verifyLabel t("email_login.verify_label")
    json.restartLabel t("email_login.restart_label")
  end
end
json.authenticityToken form_authenticity_token
